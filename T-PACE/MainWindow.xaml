<Window x:Class="T-PACE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDV - Frente de Caixa" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#DED9E2">

    <Grid Margin="15">
        <!-- Dividimos a tela em 2 colunas: Produtos (Esquerda) e Carrinho (Direita) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LADO ESQUERDO: LISTA DE PRODUTOS ================= -->
        <Border Grid.Column="0" Background="#F7F4EA" Margin="10" Padding="20" CornerRadius="8" BorderBrush="#C0B9DD" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Campo de Pesquisa -->
                <TextBox x:Name="txtBusca" Grid.Row="0" Height="45" FontSize="18" Padding="10,5,10,5" 
                         BorderBrush="#68BBBA" BorderThickness="2" Foreground="#242A2A" Background="#FFFFFF"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0" Text="Busque por código ou nome..." FontSize="16" Foreground="#6A8B8A" 
                           IsHitTestVisible="False" Margin="12,12,0,0"/>

                <!-- Lista (que depois virá do Banco de Dados) -->
                <ListBox x:Name="listaProdutos" Grid.Row="1" Margin="0,20,0,0" BorderThickness="0" FontSize="16" Background="Transparent">
                    <!-- Mockup de produto -->
                    <ListBoxItem Padding="15" BorderBrush="#C0B9DD" BorderThickness="0,0,0,1">
                        <Grid Width="500">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="001 - Camiseta Básica" FontWeight="Bold" Foreground="#242A2A"/>
                            <TextBlock Grid.Column="1" Text="R$ 49,90" Foreground="#242A2A"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Padding="15" BorderBrush="#C0B9DD" BorderThickness="0,0,0,1">
                        <Grid Width="500">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="002 - Calça Jeans" FontWeight="Bold" Foreground="#242A2A"/>
                            <TextBlock Grid.Column="1" Text="R$ 119,90" Foreground="#242A2A"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= LADO DIREITO: CARRINHO E FINALIZAÇÃO ================= -->
        <Border Grid.Column="1" Background="#F7F4EA" Margin="10" Padding="20" CornerRadius="8" BorderBrush="#C0B9DD" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título do Carrinho -->
                <TextBlock Grid.Row="0" Text="CUPOM FISCAL / PEDIDO" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#242A2A"/>

                <!-- Itens Adicionados -->
                <ListBox x:Name="listaCarrinho" Grid.Row="1" BorderThickness="0" FontSize="16" Background="#B0EBEA">
                    <ListBoxItem Padding="10">
                        <Grid Width="320">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1x Camiseta Básica" Foreground="#242A2A"/>
                            <TextBlock Grid.Column="1" Text="R$ 49,90" FontWeight="Bold" Foreground="#242A2A"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Área de Pagamento (Total e Botão) -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Border BorderBrush="#C0B9DD" BorderThickness="0,2,0,0" Padding="10,20,10,20">
                        <Grid>
                            <TextBlock Text="TOTAL:" FontSize="24" FontWeight="Bold" Foreground="#242A2A"/>
                            <TextBlock x:Name="txtTotal" Text="R$ 49,90" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#A45FCE"/>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="cbFormaPagamento" Height="40" FontSize="16" Margin="0,0,0,15" Foreground="#242A2A" BorderBrush="#68BBBA" BorderThickness="2">
                        <ComboBoxItem Content="Cartão de Crédito" IsSelected="True"/>
                        <ComboBoxItem Content="Cartão de Débito"/>
                        <ComboBoxItem Content="Dinheiro"/>
                        <ComboBoxItem Content="PIX"/>
                    </ComboBox>

                    <Button x:Name="btnFinalizar" Content="FINALIZAR VENDA" Height="60" 
                            Background="#A45FCE" Foreground="#F7F4EA" FontSize="18" FontWeight="Bold" 
                            Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>