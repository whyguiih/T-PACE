<Window x:Class="T_PACE.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" MinHeight="380" MinWidth="560" Width="820" Height="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5E3A7D" Offset="0.0"/>
            <GradientStop Color="#2A1143" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F4E79"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#193E67"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.SnapsToDevicePixels>True</Grid.SnapsToDevicePixels>

        <Border MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource GlassPane}" CornerRadius="12" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1.5" Padding="28" Margin="12" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#2A1143" Opacity="0.7" BlurRadius="24" ShadowDepth="8"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Área esquerda: logo / título maior -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border Width="110" Height="110" CornerRadius="14" Background="#5E3A7D" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="PDV" Foreground="#FFFFFF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="T-PACE" FontSize="28" FontWeight="Black" Foreground="#2A1143" Margin="0,16,0,8" />
                    <TextBlock Text="Acesse sua conta para iniciar o caixa" FontSize="15" Foreground="#2A1143" TextWrapping="Wrap" Width="220" />
                </StackPanel>

                <!-- Área direita: formulário -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,6,0,14">
                        <TextBlock Text="Usuário (e-mail)" Foreground="#2A1143" FontSize="15" FontWeight="SemiBold" />
                        <TextBox x:Name="txtEmail" Height="50" FontSize="16" HorizontalAlignment="Stretch" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,6,0,14">
                        <TextBlock Text="Senha" Foreground="#2A1143" FontSize="15" FontWeight="SemiBold" />
                        <PasswordBox x:Name="txtSenha" Height="50" FontSize="16" HorizontalAlignment="Stretch" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="txtMensagem" Foreground="#D43D3D" VerticalAlignment="Center" Margin="0,0,18,0" TextWrapping="Wrap" Width="320" FontSize="14" />
                        <Button x:Name="btnOk" Style="{StaticResource PrimaryButton}" Content="Entrar" Width="160" Height="48" Padding="10" Background="#5E3A7D" Click="BtnOk_Click" Margin="0,0,10,0" IsDefault="True"/>
                        <Button x:Name="btnCancelar" Content="Sair" Width="110" Height="48" Background="#E0E0E0" Foreground="#2A2A2A" Click="BtnCancelar_Click" IsCancel="True" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
